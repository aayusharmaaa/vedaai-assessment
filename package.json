{
  "name": "vedaai-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "AI assessment extraction and answer mapping",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "build:check": "npm run build:check --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "test": "npm run test --workspace packages/core",
    "sample": "node scripts/generate-sample.mjs",
    "quota": "node --experimental-strip-types scripts/verify-fallback.ts",
    "screenshots": "node scripts/capture-screenshots.mjs"
  }
}
